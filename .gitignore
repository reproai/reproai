__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# --- plugin artifacts ---
# Internal end-to-end test harness + fixtures (repo-root /tests only) — debug use, never shipped.
# NOTE: anchored to root so it does NOT match core/tests/ (the shippable unit-test suite).
/tests/
# Generated publish artifacts (regenerated by tools/build_public.py) — never commit to the internal repo.
# NOTE: anchored to root so it does NOT match site/public/ (deployed static assets, e.g. /certs).
dist/
/public/
# Regenerated distill output
rules-seedbank/candidates.json
# Build caches
**/__pycache__/

# R session artifacts (stray; not part of the JS/Python sources)
.Rhistory
.RData

# Local agent/editor config (e.g. Claude Code launch.json preview helper)
.claude/

# Signing keys must never be committed (registry cosign key lives in ~/.reproai/)
*.key
cosign.key
